{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Helm values schema for clinic-booking-api",
  "description": "Schema for values.yaml, values-dev.yaml, and values-prod.yaml",
  "type": "object",
  "properties": {
    "appName": {
      "type": "string",
      "description": "Application name"
    },
    "component": {
      "type": "string",
      "description": "Component identifier (e.g. server, backend)"
    },
    "partOf": {
      "type": "string",
      "description": "Part of / parent project name"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pod replicas"
    },
    "namespace": {
      "type": "string",
      "description": "Kubernetes namespace (optional)"
    },
    "image": {
      "type": "object",
      "description": "Container image configuration",
      "properties": {
        "repo": { "type": "string" },
        "name": { "type": "string" },
        "tag": { "type": "string" },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "ports": {
          "type": "object",
          "properties": {
            "name": { "type": "string" }
          }
        }
      }
    },
    "configmap": {
      "type": "object",
      "description": "ConfigMap name (optional, e.g. in prod)",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["LoadBalancer", "ClusterIP", "NodePort"], "description": "Kubernetes Service type" },
        "port": { "type": "integer" },
        "labels": { "type": "string", "description": "Optional service labels" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration list"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": ["string", "number"] }
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "fsGroup": { "type": "integer" }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hostname": { "type": "string" }
      }
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "uri": { "type": "string" },
        "database": { "type": "string" }
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "otelEndpoint": { "type": "string" }
      }
    },
    "preInstallHooks": {
      "type": "object",
      "description": "Pre-install hook jobs (e.g. connectivity checks). Hooks are deleted on success or failure.",
      "properties": {
        "jaeger": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "description": "Run pre-install Jaeger/OTLP endpoint connectivity check" },
            "imagePullSecrets": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "jaeger": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "required": [
    "appName",
    "component",
    "partOf",
    "replicaCount",
    "image",
    "service",
    "serviceAccount",
    "ingress",
    "httpRoute",
    "autoscaling",
    "resources",
    "securityContext",
    "podSecurityContext",
    "gateway",
    "mongodb",
    "tracing",
    "jaeger"
  ]
}
